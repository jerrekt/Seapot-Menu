module base_plate() {
  linear_extrude(height = plate_t)
    offset(r = corner_r)
      offset(delta = -corner_r)
        square([plate_w, plate_h]);
}

module qr_code() {
  qr_x = (plate_w - 52) / 2;
  translate([qr_x, 18, plate_t])
    for (row = [0:29-1]) {
      for (col = [0:29-1]) {
        if (qr_matrix[29-1-row][col] == 1) {
          translate([col * module_size, row * module_size, 0])
            cube([module_size, module_size, raise_h]);
        }
      }
    }
}

module sign_text() {
  translate([plate_w/2, 78, plate_t])
    linear_extrude(height = raise_h)
      text("SCAN FOR MENU", size = 6, halign = "center", valign = "center",
           font = "Liberation Sans:style=Bold");

  translate([plate_w/2, 8, plate_t])
    linear_extrude(height = raise_h)
      text("408 685 2268", size = 6, halign = "center", valign = "center",
           font = "Liberation Sans:style=Bold");
}

base_plate();
qr_code();
sign_text();
