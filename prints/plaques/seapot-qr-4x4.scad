module base_plate() {
  linear_extrude(height = plate_t)
    offset(r = corner_r)
      offset(delta = -corner_r)
        square([plate_w, plate_h]);
}

module qr_code() {
  qr_x = (plate_w - qr_size) / 2;
  translate([qr_x, 12, plate_t])
    for (row = [0:qr_dim-1]) {
      for (col = [0:qr_dim-1]) {
        if (qr_matrix[qr_dim-1-row][col] == 1) {
          translate([col * module_size, row * module_size, 0])
            cube([module_size, module_size, raise_h]);
        }
      }
    }
}

module sign_text() {
  translate([plate_w/2, 94, plate_t])
    linear_extrude(height = raise_h)
      text("SCAN FOR MENU", size = 6, halign = "center", valign = "center",
           font = "Liberation Sans:style=Bold");
}

base_plate();
qr_code();
sign_text();
